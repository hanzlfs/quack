load("@rules_python//python:defs.bzl", rules_python_py_test = "py_test")
load(":defs.bzl", "py_test")

# No GPU needed: guards the Bazel graph against lock entries silently
# dropped by rules_python's extras handling (see the file docstring).
# Uses the raw rule directly: it is not a pytest test.
rules_python_py_test(
    name = "lock_closure_test",
    size = "small",
    srcs = ["lock_closure_test.py"],
    data = ["//:requirements_lock.txt"],
    deps = ["//:quack"],
)

# One explicit target per pytest file (py_test here is the pytest wrapper
# macro from :defs.bzl). Adding a test file requires adding a declaration
# here — by design (reviewable target list, no glob magic).

