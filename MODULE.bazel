"""Bazel module for quack."""

module(
    name = "quack",
    version = "0.6.1",
)

bazel_dep(name = "rules_python", version = "2.2.0")

bazel_dep(name = "aspect_rules_py", version = "1.11.7")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
    is_default = True,
)

# Resolve the pip plane directly from pyproject.toml — no lock file in the
# source tree; pins are recorded in MODULE.bazel.lock (see
# docs/rfc_pyproject_direct_resolution.md and bazel/pypi_resolve/).
# Policy flags live HERE so dependency-resolution behavior is reviewable
# at the declaration site; each was earned the hard way:
#   --index-strategy unsafe-best-match: the default first-match can judge
#     torch==X+cu130 unsatisfiable and silently downgrade torch
#   --emit-index-url/--extra-index-url: the generated requirements carry
#     the cu130 index so rules_python sees it
#   --no-emit-package nvidia-cutlass-dsl*: the DSL is provisioned by
#     @cutlass_dsl, not the pip hub; its transitive deps stay resolved
pypi_resolve = use_extension("//bazel/pypi_resolve:extension.bzl", "pypi_resolve")
pypi_resolve.resolve(
    pyproject = "//:pyproject.toml",
    args = [
        "--extra",
        "cu13",
        "--extra",
        "dev",
        "--python-version",
        "3.12",
        "--python-platform",
        "x86_64-unknown-linux-gnu",
        "--generate-hashes",
        "--emit-index-url",
        "--extra-index-url",
        "https://download.pytorch.org/whl/cu130",
        "--index-strategy",
        "unsafe-best-match",
        "--no-emit-package",
        "nvidia-cutlass-dsl",
        "--no-emit-package",
        "nvidia-cutlass-dsl-libs-core",
        "--no-emit-package",
        "nvidia-cutlass-dsl-libs-base",
        "--no-emit-package",
        "nvidia-cutlass-dsl-libs-cu12",
        "--no-emit-package",
        "nvidia-cutlass-dsl-libs-cu13",
    ],
)
use_repo(pypi_resolve, "pypi_resolution")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "local_pypi",
    python_version = "3.12",
    requirements_lock = "@pypi_resolution//:requirements.txt",
    extra_pip_args = ["--extra-index-url=https://download.pytorch.org/whl/cu130"],
    enable_implicit_namespace_pkgs = True,
)
use_repo(pip, "local_pypi")

cutlass_dsl_repository = use_repo_rule(
    "//bazel/cutlass_dsl:repository.bzl",
    "cutlass_dsl_repository",
)

cutlass_dsl_repository(
    name = "cutlass_dsl",
    version = "4.6.1",
)
