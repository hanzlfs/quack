"""Bazel module for quack: hermetic GPU build/test.

All Python dependencies are consumed as prebuilt PyPI wheels resolved from
requirements_lock.txt (hash-pinned, generated by uv). Nothing is compiled
from source by Bazel: quack itself is pure Python and its kernels are
JIT-compiled at runtime by nvidia-cutlass-dsl.

Every wheel is pinned by sha256 in the lock file and hash-verified at fetch
time. The PyTorch cu130 index is configured via extra_pip_args on pip.parse
(see note there).
"""

module(
    name = "quack",
    version = "0.6.1",
)

bazel_dep(name = "rules_python", version = "2.2.0")

# aspect_rules_py is used only for `py_venv`: materializing a standard
# virtualenv from the Bazel dependency graph so external tools (uv, IDEs)
# can consume the hermetically built environment. Build/test targets stay
# on rules_python.
bazel_dep(name = "aspect_rules_py", version = "1.11.7")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
    is_default = True,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "local_pypi",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
    # uv's --emit-index-url does not emit pip-style --extra-index-url lines
    # for [tool.uv.index] entries marked explicit, so the PyTorch cu130 index
    # must be passed here or torch==X+cu130 resolves against pypi.org only
    # and fails.
    extra_pip_args = ["--extra-index-url=https://download.pytorch.org/whl/cu130"],
    # nvidia-cutlass-dsl is split into disjoint overlay wheels (libs-core/
    # base/cu12/cu13) that share package directories; without this flag
    # rules_python generates a stub __init__.py per wheel repo for those
    # shared dirs, and the stubs collide (with different content!) when the
    # venv is assembled. Implicit namespace packages need no stubs. Requires
    # --incompatible_default_to_explicit_init_py (set in .bazelrc).
    enable_implicit_namespace_pkgs = True,
)
use_repo(pip, "local_pypi")
