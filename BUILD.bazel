load("@aspect_rules_py//py:defs.bzl", "py_venv")
load("@rules_python//python:defs.bzl", "py_library")

# pytest reads [tool.pytest.ini_options] (addopts, filterwarnings) from
# pyproject.toml.
exports_files(["pyproject.toml"])

py_library(
    name = "cuda_userland",
    visibility = ["//visibility:private"],
    deps = [
        "@local_pypi//nvidia_cuda_cupti",
        "@local_pypi//nvidia_cuda_runtime",
        "@local_pypi//nvidia_cufft",
        "@local_pypi//nvidia_cufile",
        "@local_pypi//nvidia_curand",
        "@local_pypi//nvidia_cusolver",
        "@local_pypi//nvidia_cusparse",
        "@local_pypi//nvidia_nvjitlink",
        "@local_pypi//nvidia_nvtx",
    ],
)

py_library(
    name = "cutlass_dsl_runtime_deps",
    visibility = ["//visibility:private"],
    deps = [
        "@local_pypi//cuda_python",
        "@local_pypi//numpy",
        "@local_pypi//nvidia_cuda_nvdisasm",
        "@local_pypi//protobuf",
    ],
)

py_library(
    name = "quack",
    srcs = glob(["quack/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":cuda_userland",
        ":cutlass_dsl_runtime_deps",
        "@cutlass_dsl//:cutlass",
        "@local_pypi//apache_tvm_ffi",
        "@local_pypi//einops",
        "@local_pypi//torch",
        "@local_pypi//torch_c_dlpack_ext",
    ],
)

py_venv(
    name = "venv",
    deps = [":quack"],
)
